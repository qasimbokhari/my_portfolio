# Brevo Configuration
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Brevo email template ID for quote notification to you (internal)
BREVO_QUOTE_NOTIFICATION_TEMPLATE_ID=your_quote_notification_template_id_here

# Brevo email template ID for client auto-reply (optional)
BREVO_CLIENT_REPLY_TEMPLATE_ID=your_client_reply_template_id_here

# Brevo contact list ID for newsletter
BREVO_NEWSLETTER_LIST_ID=3

# Brevo email template ID for newsletter welcome email (optional)
BREVO_NEWSLETTER_WELCOME_TEMPLATE_ID=your_newsletter_welcome_template_id_here

# Reviews API
VITE_REVIEWS_API_URL=https://reviews.qasim.live
