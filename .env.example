# Brevo Configuration
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
# Brevo email template ID for quote notifications
BREVO_QUOTE_TEMPLATE_ID=your_quote_template_id_here
# Brevo contact list ID for newsletter
BREVO_NEWSLETTER_LIST_ID=your_newsletter_list_id_here

# Reviews API
VITE_REVIEWS_API_URL=https://reviews.qasim.live
